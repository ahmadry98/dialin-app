# DialedIn mobile environment
# Copy to .env for local work. Do not commit real secrets.

# Local simulator against a locally running FastAPI backend
EXPO_PUBLIC_AI_SHOT_API_URL=http://localhost:8000
EXPO_PUBLIC_DIALEDIN_API_URL=http://localhost:8000

# Personal AWS dev ingress
# EXPO_PUBLIC_AI_SHOT_API_URL=http://api-dev.dialedin.me
# EXPO_PUBLIC_DIALEDIN_API_URL=http://api-dev.dialedin.me

# Future production ingress, after HTTPS and production infra are ready
# EXPO_PUBLIC_AI_SHOT_API_URL=https://api.dialedin.me
# EXPO_PUBLIC_DIALEDIN_API_URL=https://api.dialedin.me

# Local scrubbed observability console logs. Set false to silence client failure logs.
EXPO_PUBLIC_OBSERVABILITY_LOGS=true

# Future Sentry SDK hook. Keep empty until the Sentry project exists.
# EXPO_PUBLIC_SENTRY_DSN=
